<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.frmCadastro"
             Title="frmCadastro" BackgroundColor="White" Padding="20"
             NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout>
        <Label 
            Text="Crie sua conta"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#333"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            Margin="0, 10, 0, 0"/>

        <Label Text="Email"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#333"
               Margin="0, 10, 0, 0"/>
        <Border Stroke="#ddd" StrokeThickness="1" Background="White" StrokeShape="RoundRectangle 10" Padding="10" Margin="0, 7, 0, 0">
            <Entry x:Name="txtEmail"
                   Placeholder="Digite seu email"
                   Keyboard="Email"
                   FontSize="16"
                   TextColor="#333"
                   BackgroundColor="Transparent" PlaceholderColor="#aaa"/>
        </Border>

        <Label Text="Senha"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#333"
               Margin="0, 10, 0, 0"/>
        <Border Stroke="#ddd" StrokeThickness="1" Background="White" StrokeShape="RoundRectangle 10" Padding="10" Margin="0, 7, 0, 0">
            <Entry x:Name="txtSenha"
                   Placeholder="Digite sua senha"
                   IsPassword="True"
                   FontSize="16"
                   TextColor="#333"
                   BackgroundColor="Transparent" PlaceholderColor="#aaa"/>
        </Border>

        <Label Text="Confirme a sua senha"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#333"
               Margin="0, 10, 0, 0"/>
        <Border Stroke="#ddd" StrokeThickness="1" Background="White" StrokeShape="RoundRectangle 10" Padding="10" Margin="0, 7, 0, 0">
            <Entry x:Name="txtConfirmSenha"
                   Placeholder="Confirme a sua senha"
                   IsPassword="True"
                   FontSize="16"
                   TextColor="#333"
                   BackgroundColor="Transparent" PlaceholderColor="#aaa"/>
        </Border>

        <Button Text="Cadastrar"
                BackgroundColor="#007AFF"
                TextColor="White"
                FontSize="18"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="Button_Clicked" 
                Margin="0, 25, 0, 0"/>

        <Label Text="Já tem uma conta? Faça login."
               HorizontalOptions="Center"
               TextColor="#4e8ef7"
               FontSize="14"
               Margin="0, 12, 0, 0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </Label.GestureRecognizers>
        </Label>
    </VerticalStackLayout>
</ContentPage>  