<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.frmLogin"
             Title="Login" BackgroundColor="White" Padding="20"
             NavigationPage.HasNavigationBar="False">
    
    <VerticalStackLayout VerticalOptions="Center" Spacing="16"> 
        <Image
            Source="logo.jpeg"
            Aspect="AspectFill"
            HeightRequest="256"
            WidthRequest="256"
            HorizontalOptions="Center"
            Margin="0,0,0,20" /> 
        
        <Label
            Text="Bem-Vindo ao"
            VerticalOptions="Center"
            HorizontalOptions="Center" 
            TextColor="#333"
            FontAttributes="Bold"
            FontSize="32"/>
        <Label
            Text="VanderPET"
            VerticalOptions="Center"
            HorizontalOptions="Center" 
            TextColor="#333"
            FontAttributes="Bold"
            FontSize="32"
            Margin="0, -20, 0, 0"/>

        <Label
            Text="Usuário"
            TextColor="#333"
            FontAttributes="Bold"
            FontSize="14"/>

        <Border Stroke="#ddd" StrokeThickness="1" Background="White" StrokeShape="RoundRectangle 10" Margin="0, -10, 0, 0">
            <Entry x:Name="txtUsuario" 
                       Placeholder="Digite seu usuário"
                       FontSize="16"
                       TextColor="#333"
                       BackgroundColor="Transparent" 
                       PlaceholderColor="#aaa"
                       Margin="10,0"/>
        </Border>

        <Label Text="Senha"
               TextColor="#333"
               FontAttributes="Bold"
               FontSize="14" 
               Margin="0, -3, 0, 0"/>

        <Border Stroke="#ddd" StrokeThickness="1" Background="White" StrokeShape="RoundRectangle 10" Margin="0, -10, 0, 0">
            <Entry x:Name="txtSenha"
                       Placeholder="Digite sua senha"
                       IsPassword="True"
                       FontSize="16"
                       TextColor="#333"
                       BackgroundColor="Transparent"
                       PlaceholderColor="#aaa"
                       Margin="10,0"/>
        </Border>
        <Button
            Text="Login"
            BackgroundColor="#FF6F61"
            TextColor="White"
            FontSize="18"
            CornerRadius="10"
            HeightRequest="50"
            Clicked="Button_Clicked"/>

        <Label Text="Não tem uma conta? Cadastre-se"
               HorizontalOptions="Center"
               TextColor="#4e8ef7"
               FontSize="14">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
            </Label.GestureRecognizers>
        </Label>
        
    </VerticalStackLayout>
</ContentPage>